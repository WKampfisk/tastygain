{
  "name": "InventoryItem",
  "type": "object",
  "description": "Pantry, fridge, or ingredient stock",
  "properties": {
    "household_id": { "type": "string" },
    "name": { "type": "string" },
    "category": {
      "type": "string",
      "enum": [
        "fruit_veg",
        "dairy",
        "meat_fish",
        "bread_bakery",
        "frozen",
        "pantry",
        "drinks",
        "snacks",
        "nutritional_drinks",
        "household"
      ],
      "default": "pantry"
    },
    "quantity": { "type": "number", "default": 1 },
    "unit": { "type": "string", "default": "stk" },
    "location": { "type": "string", "default": "Pantry" },
    "expiry_date": { "type": "string", "format": "date" },
    "minimum_stock": { "type": "number", "default": 1 },
    "restock_enabled": { "type": "boolean", "default": true },
    "store_product_key": { "type": "string", "description": "Link to seed catalogue essentialKey" },
    "preferred_chain": {
      "type": "string",
      "enum": ["rema_1000", "kiwi", "coop", "spar", "bunnpris", "joker"]
    }
  },
  "required": ["household_id", "name"],
  "rls": {
    "create": true,
    "read": { "created_by": "{{user.email}}" },
    "update": { "created_by": "{{user.email}}" },
    "delete": { "created_by": "{{user.email}}" }
  }
}
